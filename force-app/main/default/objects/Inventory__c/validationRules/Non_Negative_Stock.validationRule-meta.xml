<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Non_Negative_Stock</fullName>
    <active>true</active>
    <errorConditionFormula>OR(Quantity__c &lt; 0, Reorder_Level__c &lt; 0)</errorConditionFormula>
    <errorMessage>Quantity and Reorder Level cannot be negative.</errorMessage>
</ValidationRule>
