<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Booking_In_Future</fullName>
    <active>true</active>
    <errorConditionFormula>AND(ISNEW(), Booking_Date_Time__c &lt; NOW())</errorConditionFormula>
    <errorMessage>Booking time must be in the future.</errorMessage>
</ValidationRule>
