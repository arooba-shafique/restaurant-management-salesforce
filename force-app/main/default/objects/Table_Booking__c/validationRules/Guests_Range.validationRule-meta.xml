<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Guests_Range</fullName>
    <active>true</active>
    <errorConditionFormula>OR(Guests__c &lt; 1, Guests__c &gt; 20)</errorConditionFormula>
    <errorMessage>Guests must be between 1 and 20.</errorMessage>
</ValidationRule>
